#!/usr/bin/env bash
# factory — the factory's command line. Every deterministic step of the pipeline is a
# subcommand here, so skills and the unattended loop run the exact same code.
set -u
FACTORY_SCRIPTS="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
FACTORY_PLUGIN="$(dirname "$FACTORY_SCRIPTS")"
export FACTORY_SCRIPTS FACTORY_PLUGIN

usage() {
  cat <<'USAGE'
usage: factory <command> [args]

  doctor                 check prerequisites, config, and GitHub access for this project
  github-setup [--apply]
                         labels, merge settings, branch protection (shows changes first)
  sync [--apply | --pr]  compare factory-managed files with the latest factory;
                         --apply writes them, --pr opens a "factory sync" PR
  tickets feature|create|next|list|show
                         GitHub plumbing for specs and tickets (sub-issues, blocked-by); show: a ticket + comments
  start [<issue> | next] pick up a ticket: lock, preflight, prerequisites, drift, worktree
  review begin <issue> | judges | assemble [--resolve] | resolve-begin
                         local review through the reviewer/judge/resolver subagents
  open-pr <issue>        push the branch and open the PR with the review attached
  run [<parent-issue>]   unattended loop: start → implement → review → fix → open-pr, repeat
  block <issue> <reason> label a ticket blocked and comment the reason
  repo                   owner/repo from the git remote, for `gh api repos/$(factory repo)/…`
  prompt <agent|skill>   print the full instructions of a factory agent or skill
  archive-specs          open an "Archive spec" PR for every feature whose tickets are all closed
USAGE
}

cmd=${1:-help}
shift || true
case "$cmd" in
  doctor | github-setup | sync | tickets | start | review | open-pr | run | block | archive-specs | prompt)
    exec bash "$FACTORY_SCRIPTS/cmd/$cmd.sh" "$@"
    ;;
  repo)
    # shellcheck source=common.sh
    . "$FACTORY_SCRIPTS/common.sh"
    factory_repo_slug || die "no GitHub remote for $(pwd)"
    echo
    ;;
  help | -h | --help) usage ;;
  *)
    usage >&2
    exit 1
    ;;
esac
